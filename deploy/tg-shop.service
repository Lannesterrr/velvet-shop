# /etc/systemd/system/tg-shop.service
# Установка:
#   sudo cp deploy/tg-shop.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tg-shop
# Логи:  journalctl -u tg-shop -f

[Unit]
Description=Telegram Mini App shop (API + bot)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=shop
WorkingDirectory=/home/shop/tg-shop/server
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
# Ограничения безопасности
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
